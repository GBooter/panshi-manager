{
  "magic": "dsg.config.meta",
  "version": "1.0",
  "contents": {
    "monitor.enabled": {
      "value": false, "serial": 0, "flags": [], "name": "monitor.enabled",
      "description": "磁盘监控总开关（开启后由 systemd user timer 周期采样）",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.pollMinutes": {
      "value": 15, "serial": 0, "flags": [], "name": "monitor.pollMinutes",
      "description": "高频轮询间隔（分钟），对应 timer 周期",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.baselineDays": {
      "value": 7, "serial": 0, "flags": [], "name": "monitor.baselineDays",
      "description": "智能基线学习天数",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.alertMode": {
      "value": "baseline", "serial": 0, "flags": [], "name": "monitor.alertMode",
      "description": "告警模式：baseline（智能基线）/ fixed（固定阈值）",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.fixedThresholdMB": {
      "value": 1024, "serial": 0, "flags": [], "name": "monitor.fixedThresholdMB",
      "description": "固定阈值（MB）",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.baselineMultiplier": {
      "value": 3.0, "serial": 0, "flags": [], "name": "monitor.baselineMultiplier",
      "description": "基线倍数",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.minAlertMB": {
      "value": 512, "serial": 0, "flags": [], "name": "monitor.minAlertMB",
      "description": "告警最小绝对值（MB）",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.cooldownHours": {
      "value": 6, "serial": 0, "flags": [], "name": "monitor.cooldownHours",
      "description": "同一目录告警冷却时长（小时）",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.quietStart": {
      "value": "23:00", "serial": 0, "flags": [], "name": "monitor.quietStart",
      "description": "免打扰起始（HH:mm），期间只记录不推送",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.quietEnd": {
      "value": "07:00", "serial": 0, "flags": [], "name": "monitor.quietEnd",
      "description": "免打扰结束（HH:mm）",
      "permissions": "readwrite", "visibility": "private"
    },

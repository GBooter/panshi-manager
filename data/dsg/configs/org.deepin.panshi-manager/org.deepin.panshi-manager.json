      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.samplesRetentionDays": {
      "value": 90, "serial": 0, "flags": [], "name": "monitor.samplesRetentionDays",
      "description": "高频样本保留天数",
      "permissions": "readwrite", "visibility": "private"
    },
    "monitor.memoryCacheDays": {
      "value": 90, "serial": 0, "flags": [], "name": "monitor.memoryCacheDays",
